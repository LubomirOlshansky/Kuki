<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>KukiCloudContainer</key>
	<string>$(KUKI_CLOUD_CONTAINER)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>com.apple.home</string>
	</array>
	<key>NSHomeKitUsageDescription</key>
	<string>Kūki reads the CO₂, temperature, humidity and particle levels from your air quality sensor in Apple Home.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
