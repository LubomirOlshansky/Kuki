    "No chime or notification. The ensō turns shu at **%@ ppm**." : {
      "comment" : "Onboarding, Plan screen: the placeholder is the CO₂ limit, e.g. 1000. Ensō = the Zen brush circle that shows CO₂, keep the word. Shu = the app's Japanese vermilion alert colour, keep the word. The text between ** and ** is set in a heavier weight; keep the two ** markers around the matching words.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا رنين ولا إشعار. يتحوّل ensō إلى لون shu عند **%@ ppm**."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Klang und keine Mitteilung. Das Ensō färbt sich bei **%@ ppm** in Shu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin sonido ni notificación. El ensō se vuelve shu a **%@ ppm**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni son ni notification. L'ensō passe au shu à **%@ ppm**."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई घंटी या सूचना नहीं। **%@ ppm** पर ensō shu रंग का हो जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa bunyi atau pemberitahuan. Ensō berubah menjadi shu pada **%@ ppm**."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun suono né notifica. L'ensō diventa shu a **%@ ppm**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "風鈴の音も通知もありません。円相は**%@ ppm**で朱に染まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "풍경 소리도 알림도 없습니다. **%@ ppm**에서 ensō가 shu(주홍색)로 바뀝니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen klank of melding. De ensō wordt shu bij **%@ ppm**."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez dzwonka i powiadomień. Ensō zmienia kolor na shu przy **%@ ppm**."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem toque nem notificação. O ensō fica shu em **%@ ppm**."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без звона и уведомлений. Ensō окрашивается в цвет shu при **%@ ppm**."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen ringning eller notis. Ensō blir shu vid **%@ ppm**."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีเสียงกระดิ่งหรือการแจ้งเตือน ensō จะเปลี่ยนเป็นสี shu ที่ **%@ ppm**"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çan da bildirim de yok. Ensō **%@ ppm**'de shu rengine döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без дзвону й сповіщень. Ensō набуває кольору shu при **%@ ppm**."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không chuông, không thông báo. Ensō chuyển sang màu shu ở **%@ ppm**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有铃声，也没有通知。圆相在 **%@ ppm** 时变为朱色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有鈴聲，也沒有通知。圓相在 **%@ ppm** 時變為朱色。"
          }
        }
      }
    },
