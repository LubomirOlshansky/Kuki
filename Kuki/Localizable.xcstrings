    "Places are kept. This can't be undone — export first if you want a copy." : {
      "comment" : "Settings: message of the 'Delete every recording?' confirmation (no iCloud)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ الأماكن. لا يمكن التراجع عن ذلك — صدّر أولًا إن أردت نسخة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orte bleiben erhalten. Dies kann nicht widerrufen werden – exportieren Sie vorher, wenn Sie eine Kopie möchten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los lugares se conservan. Esta acción no se puede deshacer — exporta antes si quieres una copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lieux sont conservés. Cette action est irréversible — exportez d'abord si vous voulez une copie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जगहें रखी जाएँगी। इसे पूर्ववत नहीं किया जा सकता — अगर आप कॉपी चाहते हैं, तो पहले एक्सपोर्ट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempat tetap disimpan. Tindakan ini tidak dapat diurungkan — ekspor dulu jika Anda ingin salinannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I luoghi vengono mantenuti. Questa azione non può essere annullata — esporta prima se vuoi una copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場所は保持されます。この操作は取り消せません — コピーが必要な場合は、先に書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장소는 유지됩니다. 이 작업은 되돌릴 수 없습니다 — 사본이 필요하면 먼저 내보내세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plekken blijven bewaard. Dit kan niet ongedaan worden gemaakt — exporteer eerst als je een kopie wilt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miejsca zostaną zachowane. Tej operacji nie można cofnąć — jeśli chcesz mieć kopię, najpierw wyeksportuj dane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os locais são mantidos. Não é possível desfazer — exporte antes se quiser uma cópia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Места сохранятся. Это действие нельзя отменить — сначала экспортируйте данные, если нужна копия."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platserna behålls. Det går inte att ångra — exportera först om du vill ha en kopia."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตำแหน่งจะถูกเก็บไว้ การกระทำนี้ไม่สามารถเลิกทำได้ — ส่งออกก่อนหากต้องการเก็บสำเนา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerler korunur. Bu işlem geri alınamaz — bir kopya istiyorsanız önce dışa aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Місця збережуться. Цю дію не можна скасувати — спершу експортуйте дані, якщо потрібна копія."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các vị trí được giữ lại. Không thể hoàn tác thao tác này — hãy xuất trước nếu bạn muốn giữ một bản sao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地点会保留。此操作无法撤销——如需副本，请先导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地點會保留。此動作無法復原——如需副本，請先輸出。"
          }
        }
      }
    },
