    "Below 1000 ppm \"hygienisch unbedenklich\", 1000–2000 \"auffällig\", above 2000 \"inakzeptabel\"." : {
      "comment" : "Onboarding, Sources list: what a cited study or guideline says, shown under its citation. Numbers, units and proper names stay. The three German terms quote the source and stay in German.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دون 1000 ppm «hygienisch unbedenklich»، و1000–2000 «auffällig»، وفوق 2000 «inakzeptabel»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter 1000 ppm „hygienisch unbedenklich“, 1000–2000 „auffällig“, über 2000 „inakzeptabel“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por debajo de 1000 ppm «hygienisch unbedenklich», 1000–2000 «auffällig», por encima de 2000 «inakzeptabel»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sous 1000 ppm « hygienisch unbedenklich », 1000–2000 « auffällig », au-dessus de 2000 « inakzeptabel »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1000 ppm से नीचे “hygienisch unbedenklich”, 1000–2000 “auffällig”, 2000 से ऊपर “inakzeptabel”।"
