        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki deelt gebruiksstatistieken om de app te verbeteren. Je kunt dit uitzetten in Instellingen › Privacy."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki udostępnia statystyki użycia, by ulepszać aplikację. Możesz to wyłączyć w: Ustawienia › Prywatność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Kūki compartilha estatísticas de uso para melhorar o app. Você pode desativar isso em Ajustes › Privacidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki отправляет статистику использования, чтобы улучшать приложение. Это можно выключить в разделе Настройки › Конфиденциальность."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki delar användningsstatistik för att förbättra appen. Du kan stänga av det i Inställningar › Integritet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki แชร์สถิติการใช้งานเพื่อปรับปรุงแอป คุณปิดได้ใน การตั้งค่า › ความเป็นส่วนตัว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki, uygulamayı geliştirmek için kullanım istatistiklerini paylaşır. Bunu Ayarlar › Gizlilik bölümünden kapatabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki надсилає статистику використання, щоб покращувати програму. Це можна вимкнути в розділі Параметри › Приватність."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki chia sẻ số liệu thống kê sử dụng để cải thiện ứng dụng. Bạn có thể tắt tính năng này trong Cài đặt › Quyền riêng tư."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
