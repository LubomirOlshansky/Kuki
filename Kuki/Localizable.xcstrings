    "Kūki shares usage statistics to improve the app. You can turn this off in Kūki › Settings… › Privacy." : {
      "comment" : "Onboarding, Plan screen, Mac: analytics disclosure. Kūki › Settings… › Privacy is the path to the app's own setting; Settings… and Privacy must match the menu item and the Settings section names",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشارك Kūki إحصاءات الاستخدام لتحسين التطبيق. يمكنك إيقاف ذلك من Kūki › الإعدادات… › الخصوصية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki teilt Nutzungsstatistiken, um die App zu verbessern. Sie können das unter Kūki › Einstellungen … › Datenschutz ausschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki comparte estadísticas de uso para mejorar la app. Puedes desactivarlo en Kūki › Ajustes… › Privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki partage des statistiques d'utilisation pour améliorer l'app. Vous pouvez désactiver cela dans Kūki › Réglages… › Confidentialité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki ऐप को बेहतर बनाने के लिए उपयोग के आँकड़े साझा करता है। आप इसे Kūki › सेटिंग्ज़… › गोपनीयता में बंद कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki membagikan statistik penggunaan untuk menyempurnakan app. Anda dapat mematikannya di Kūki › Pengaturan… › Privasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki condivide statistiche d'uso per migliorare l'app. Puoi disattivarle in Kūki › Impostazioni… › Privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KūkiはAppの改善のために利用状況の統計を共有します。「Kūki」›「設定…」›「プライバシー」でオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki는 앱 개선을 위해 사용 통계를 공유합니다. Kūki › 설정… › 개인정보 보호에서 끌 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki deelt gebruiksstatistieken om de app te verbeteren. Je kunt dit uitzetten in Kūki › Instellingen… › Privacy."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki udostępnia statystyki użycia, by ulepszać aplikację. Możesz to wyłączyć w: Kūki › Ustawienia… › Prywatność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Kūki compartilha estatísticas de uso para melhorar o app. Você pode desativar isso em Kūki › Ajustes… › Privacidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki отправляет статистику использования, чтобы улучшать приложение. Это можно выключить в меню Kūki › Настройки… › Конфиденциальность."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki delar användningsstatistik för att förbättra appen. Du kan stänga av det i Kūki › Inställningar… › Integritet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki แชร์สถิติการใช้งานเพื่อปรับปรุงแอป คุณปิดได้ใน Kūki › การตั้งค่า… › ความเป็นส่วนตัว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki, uygulamayı geliştirmek için kullanım istatistiklerini paylaşır. Bunu Kūki › Ayarlar… › Gizlilik bölümünden kapatabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki надсилає статистику використання, щоб покращувати програму. Це можна вимкнути в меню Kūki › Параметри… › Приватність."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki chia sẻ số liệu thống kê sử dụng để cải thiện ứng dụng. Bạn có thể tắt tính năng này trong Kūki › Cài đặt… › Quyền riêng tư."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki 会共享使用统计以改进 App。可在“Kūki” › “设置…” › “隐私”中关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki 會分享使用統計資料以改進 App。可在「Kūki」›「設定…」›「隱私權」中關閉。"
          }
        }
      }
    },
    "Kūki shares usage statistics to improve the app. You can turn this off in Settings › Privacy." : {
      "comment" : "Onboarding, Plan screen: analytics disclosure. Settings › Privacy is the path to the app's own setting; Privacy must match the section name in the app's Settings",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشارك Kūki إحصاءات الاستخدام لتحسين التطبيق. يمكنك إيقاف ذلك من الإعدادات › الخصوصية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki teilt Nutzungsstatistiken, um die App zu verbessern. Sie können das unter Einstellungen › Datenschutz ausschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki comparte estadísticas de uso para mejorar la app. Puedes desactivarlo en Ajustes › Privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki partage des statistiques d'utilisation pour améliorer l'app. Vous pouvez désactiver cela dans Réglages › Confidentialité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki ऐप को बेहतर बनाने के लिए उपयोग के आँकड़े साझा करता है। आप इसे सेटिंग्ज़ › गोपनीयता में बंद कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki membagikan statistik penggunaan untuk menyempurnakan app. Anda dapat mematikannya di Pengaturan › Privasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki condivide statistiche d'uso per migliorare l'app. Puoi disattivarle in Impostazioni › Privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KūkiはAppの改善のために利用状況の統計を共有します。「設定」›「プライバシー」でオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki는 앱 개선을 위해 사용 통계를 공유합니다. 설정 › 개인정보 보호에서 끌 수 있습니다."
