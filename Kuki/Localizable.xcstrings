          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki ติดตามเซ็นเซอร์ได้ครั้งละหนึ่งตัว คุณเปลี่ยนได้ในการตั้งค่า"
