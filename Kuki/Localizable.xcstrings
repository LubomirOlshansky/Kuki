    "Windows mostly stay shut" : {
      "comment" : "Onboarding, Questions screen: subtitle of the Rarely answer",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النوافذ مغلقة غالبًا"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenster bleiben meist zu"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ventanas suelen estar cerradas"
