        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Kūki dans Réglages Système › Confidentialité et sécurité › Maison, puis revenez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
