    "Next, your %@ will ask whether Kūki may use your Home data." : {
      "comment" : "Onboarding, Apple Home screen: the placeholder is iPhone, iPad or Mac",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد ذلك، سيسألك %@ إن كان بإمكان Kūki استخدام بيانات المنزل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Nächstes fragt Ihr %@, ob Kūki Ihre Home-Daten verwenden darf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A continuación, tu %@ te preguntará si Kūki puede usar tus datos de Casa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre %@ va ensuite vous demander si Kūki peut utiliser vos données Maison."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगे, आपका %@ पूछेगा कि क्या Kūki आपके होम डेटा का उपयोग कर सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berikutnya, %@ Anda akan menanyakan apakah Kūki boleh menggunakan data Rumah Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poi il tuo %@ ti chiederà se Kūki può usare i tuoi dati di Casa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に、%@がKūkiに「ホーム」のデータの使用を許可するか確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음으로 %@에서 Kūki가 홈 데이터를 사용해도 되는지 묻습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daarna vraagt je %@ of Kūki je Woning-gegevens mag gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz Twój %@ zapyta, czy Kūki może używać danych z aplikacji Dom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em seguida, o seu %@ vai perguntar se o Kūki pode usar os seus dados da Casa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Далее Ваш %@ спросит, может ли Kūki использовать данные приложения «Дом»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedan frågar din %@ om Kūki får använda dina Hem-data."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถัดไป %@ ของคุณจะถามว่า Kūki ใช้ข้อมูลบ้านของคุณได้หรือไม่"
