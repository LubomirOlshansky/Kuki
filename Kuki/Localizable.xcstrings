    "Where Germany's Umweltbundesamt stops calling air harmless." : {
      "comment" : "Onboarding, Fūrin screen: subtitle of the 1000 ppm limit. Umweltbundesamt = German Environment Agency, keep the name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حيث يتوقف Umweltbundesamt الألماني عن وصف الهواء بأنه غير ضار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo das Umweltbundesamt aufhört, Luft unbedenklich zu nennen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donde el Umweltbundesamt alemán deja de considerar inocuo el aire."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Là où l'Umweltbundesamt allemand cesse de juger l'air sans danger."
