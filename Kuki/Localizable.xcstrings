            "state" : "translated",
            "value" : "Apple Home, Kūki को तभी अपडेट करता है जब यह सामने वाला ऐप हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home hanya memperbarui Kūki saat Kūki menjadi app terdepan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home aggiorna Kūki solo quando è in primo piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple HomeがKūkiを更新するのは、前面にあるときだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home은 Kūki가 앞에 있을 때만 업데이트합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home werkt Kūki alleen bij als het de voorste app is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home aktualizuje Kūki tylko wtedy, gdy aplikacja jest na pierwszym planie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Apple Home só atualiza o Kūki enquanto ele está em primeiro plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home обновляет Kūki, только пока он на переднем плане."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home uppdaterar bara Kūki när appen är i förgrunden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home จะอัปเดต Kūki เฉพาะเมื่อเป็นแอปที่อยู่ด้านหน้าเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home, Kūki'yi yalnızca öndeyken günceller."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home оновлює Kūki, лише поки він на передньому плані."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home chỉ cập nhật Kūki khi đó là ứng dụng ở phía trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home 只在 Kūki 位于前台时更新它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home 只在 Kūki 位於前景時更新它。"
          }
        }
      }
    },
    "Apple Home only updates the app in front. Station Mode keeps Kūki in front and recording." : {
      "comment" : "Now screen: why recording is paused. 'Station Mode' is Kūki's dim, always-awake screen mode.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحدّث Apple Home إلا التطبيق الموجود في المقدمة. يُبقي وضع المحطة Kūki في المقدمة ويواصل التسجيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home aktualisiert nur die App im Vordergrund. Der Stationsmodus hält Kūki im Vordergrund und zeichnet weiter auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home solo actualiza la app en primer plano. El modo Estación mantiene Kūki en primer plano y registrando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home ne met à jour que l'app au premier plan. Le mode Station garde Kūki au premier plan et en enregistrement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home सिर्फ़ सामने वाले ऐप को अपडेट करता है। स्टेशन मोड Kūki को सामने और रिकॉर्डिंग में रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home hanya memperbarui app yang ada di depan. Mode Stasiun menjaga Kūki tetap di depan dan merekam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home aggiorna solo l'app in primo piano. La modalità Stazione tiene Kūki in primo piano e in registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Homeは前面のAppだけを更新します。据え置きモードなら、Kūkiが前面のまま記録を続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home은 앞에 있는 앱만 업데이트합니다. 스테이션 모드는 Kūki를 앞에 둔 채 기록을 계속합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home werkt alleen de app op de voorgrond bij. Stationmodus houdt Kūki op de voorgrond, zodat het blijft registreren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home aktualizuje tylko aplikację na pierwszym planie. Tryb stacji utrzymuje Kūki na pierwszym planie i zapisuje pomiary."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Apple Home só atualiza o app em primeiro plano. O Modo Estação mantém o Kūki em primeiro plano e registrando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home обновляет только активное приложение. Режим «Станция» держит Kūki на переднем плане и продолжает запись."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home uppdaterar bara appen i förgrunden. Stationsläge håller Kūki i förgrunden så att den fortsätter registrera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home อัปเดตเฉพาะแอปที่อยู่ด้านหน้า โหมดสถานีช่วยให้ Kūki อยู่ด้านหน้าและบันทึกต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home yalnızca öndeki uygulamayı günceller. İstasyon Modu, Kūki'yi önde ve kayıtta tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home оновлює лише активну програму. Режим «Станція» тримає Kūki на передньому плані й продовжує запис."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home chỉ cập nhật ứng dụng ở phía trước. Chế độ Trạm giữ Kūki ở phía trước và tiếp tục ghi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home 只更新前台的 App。常亮模式会让 Kūki 保持在前台并持续记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home 只更新前景的 App。常亮模式會讓 Kūki 保持在前景並持續記錄。"
          }
        }
      }
    },
    "Apple Home shares readings only while Kūki is open on your iPad. For an unbroken record, leave a spare iPad or iPhone in Station Mode, or let a Mac record from its menu bar." : {
      "comment" : "Onboarding, Listen screen: card body on iPad. Station Mode = the app's always-on screen mode, same name as in Settings",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يشارك Apple Home القراءات إلا عندما يكون Kūki مفتوحًا على iPad. لتسجيل متواصل، اترك جهاز iPad أو iPhone احتياطيًا في وضع المحطة، أو دع جهاز Mac يسجّل من شريط القائمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home liefert Messwerte nur, solange Kūki auf Ihrem iPad geöffnet ist. Für eine lückenlose Aufzeichnung lassen Sie ein freies iPad oder iPhone im Stationsmodus laufen oder einen Mac über die Menüleiste aufzeichnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home solo comparte lecturas mientras Kūki está abierto en tu iPad. Para un registro sin interrupciones, deja un iPad o iPhone libre en modo Estación, o deja que un Mac registre desde su barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home ne transmet les mesures que lorsque Kūki est ouvert sur votre iPad. Pour un relevé sans interruption, laissez un iPad ou un iPhone libre en mode Station, ou laissez un Mac enregistrer depuis sa barre des menus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home रीडिंग तभी साझा करता है जब Kūki आपके iPad पर खुला हो। लगातार रिकॉर्ड के लिए, एक अतिरिक्त iPad या iPhone को स्टेशन मोड में छोड़ दें, या किसी Mac को उसके मेनू बार से रिकॉर्ड करने दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home hanya membagikan pembacaan saat Kūki terbuka di iPad Anda. Untuk catatan tanpa jeda, biarkan iPad atau iPhone cadangan dalam Mode Stasiun, atau biarkan Mac merekam dari bar menunya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home condivide le rilevazioni solo mentre Kūki è aperta su iPad. Per una registrazione continua, lascia un iPad o un iPhone libero in modalità Stazione, oppure fai registrare un Mac dalla sua barra dei menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Homeが測定値を渡すのは、iPadでKūkiを開いている間だけです。途切れなく記録するには、予備のiPadやiPhoneを据え置きモードにしておくか、Macのメニューバーから記録してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home은 iPad에서 Kūki가 열려 있는 동안에만 측정값을 공유합니다. 끊김 없이 기록하려면 남는 iPad나 iPhone을 스테이션 모드로 두거나, Mac의 메뉴 막대에서 기록하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home deelt metingen alleen terwijl Kūki open is op je iPad. Voor een ononderbroken registratie laat je een reserve-iPad of -iPhone in Stationmodus staan, of laat je een Mac registreren vanuit de menubalk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home udostępnia odczyty tylko wtedy, gdy aplikacja Kūki jest otwarta na iPadzie. Aby mieć ciągły zapis, zostaw zapasowego iPada lub iPhone’a w trybie stacji albo pozwól, by Mac zapisywał pomiary z paska menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Apple Home só compartilha leituras enquanto o Kūki está aberto no iPad. Para um registro contínuo, deixe um iPad ou iPhone extra no Modo Estação, ou deixe um Mac registrar pela barra de menus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home передаёт показания, только пока Kūki открыт на iPad. Для непрерывной записи оставьте запасной iPad или iPhone в режиме «Станция» или пусть запись ведёт Mac из строки меню."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home delar mätvärden bara medan Kūki är öppen på din iPad. För en obruten logg kan du lämna en extra iPad eller iPhone i Stationsläge, eller låta en Mac registrera från menyraden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home จะแชร์ค่าที่วัดได้เฉพาะเมื่อ Kūki เปิดอยู่บน iPad ของคุณ หากต้องการบันทึกต่อเนื่อง ให้วาง iPad หรือ iPhone สำรองไว้ในโหมดสถานี หรือให้ Mac บันทึกจากแถบเมนู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home, değerleri yalnızca Kūki iPad'inizde açıkken paylaşır. Kesintisiz kayıt için yedek bir iPad'i veya iPhone'u İstasyon Modu'nda bırakın ya da bir Mac menü çubuğundan kaydetsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home передає покази, лише поки Kūki відкритий на iPad. Для безперервного запису залиште запасний iPad чи iPhone в режимі «Станція» або нехай запис веде Mac зі смуги меню."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Home chỉ chia sẻ số đo khi Kūki đang mở trên iPad của bạn. Để ghi liên tục, hãy để một iPad hoặc iPhone dự phòng ở Chế độ Trạm, hoặc để máy Mac ghi từ thanh menu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有当 Kūki 在 iPad 上打开时，Apple Home 才会共享读数。要不间断地记录，可将闲置的 iPad 或 iPhone 置于常亮模式，或让 Mac 从菜单栏记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有當 Kūki 在 iPad 上開啟時，Apple Home 才會分享讀數。若要不間斷地記錄，可將閒置的 iPad 或 iPhone 置於常亮模式，或讓 Mac 從選單列記錄。"
          }
        }
      }
    },
