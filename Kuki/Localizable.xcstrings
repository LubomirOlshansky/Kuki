        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa è l'aria intorno al tuo sensore in questo momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これがいまのセンサーまわりの空気です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 센서 주변의 공기입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat is de lucht rond je sensor op dit moment."
