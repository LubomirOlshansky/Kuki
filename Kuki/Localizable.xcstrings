    "Kūki follows one sensor at a time. You can switch in Settings." : {
      "comment" : "Onboarding, Apple Home screen: body when several sensors were found",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتابع Kūki مستشعرًا واحدًا في كل مرة. يمكنك التبديل من الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki folgt jeweils einem Sensor. Sie können in den Einstellungen wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki sigue un solo sensor a la vez. Puedes cambiarlo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki suit un seul capteur à la fois. Vous pouvez en changer dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki एक समय में एक सेंसर को फ़ॉलो करता है। आप सेटिंग्ज़ में बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki mengikuti satu sensor dalam satu waktu. Anda dapat menggantinya di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki segue un sensore alla volta. Puoi cambiarlo in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūkiが見守るセンサーは一度に1台です。「設定」で切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
