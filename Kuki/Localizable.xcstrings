        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जहाँ जर्मनी का Umweltbundesamt हवा को हानिरहित कहना बंद कर देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batas saat Umweltbundesamt Jerman berhenti menyebut udara aman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove l'Umweltbundesamt tedesco smette di considerare l'aria innocua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドイツのUmweltbundesamtが、空気を無害と呼ばなくなる境目です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "독일 Umweltbundesamt가 공기를 더 이상 무해하다고 보지 않는 지점입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar het Duitse Umweltbundesamt lucht niet meer onschadelijk noemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu niemiecki Umweltbundesamt przestaje uznawać powietrze za nieszkodliwe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde o Umweltbundesamt da Alemanha deixa de considerar o ar inofensivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь немецкий Umweltbundesamt перестаёт называть воздух безвредным."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Där Tysklands Umweltbundesamt slutar kalla luften ofarlig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จุดที่ Umweltbundesamt ของเยอรมนีเลิกเรียกอากาศว่าไม่เป็นอันตราย"
