            "state" : "translated",
            "value" : "Perekaman dijeda hingga sensor kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione è in pausa finché non torna raggiungibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "センサーが戻るまで記録を一時停止します。"
