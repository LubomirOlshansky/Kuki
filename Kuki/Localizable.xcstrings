    "Like outside. Nothing to do." : {
      "comment" : "Advice line under the air level title when CO₂ is as low as outdoor air.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثل الخارج. لا شيء لتفعله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie draußen. Nichts zu tun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como al aire libre. Nada que hacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme dehors. Rien à faire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाहर जैसी। कुछ करने की ज़रूरत नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seperti di luar. Tidak perlu apa-apa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come all'aperto. Niente da fare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外と同じくらい。何もしなくて大丈夫です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바깥 공기와 같습니다. 그대로 두셔도 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoals buiten. Niets te doen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak na zewnątrz. Nic nie trzeba robić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como lá fora. Nada a fazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как на улице. Ничего делать не нужно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som utomhus. Inget att göra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เหมือนข้างนอก ไม่ต้องทำอะไร"
          }
        },
        "tr" : {
