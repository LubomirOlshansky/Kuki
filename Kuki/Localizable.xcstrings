    "Allow Home access for Kūki in Settings, then come back." : {
      "comment" : "Shown when Kūki has no access to Apple Home (iPhone/iPad). 'Settings' is the iOS Settings app.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لـ Kūki بالوصول إلى المنزل من الإعدادات، ثم عُد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben Sie Kūki in den Einstellungen den Zugriff auf Home und kommen Sie dann zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a Casa para Kūki en Ajustes y vuelve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l'accès à Maison pour Kūki dans Réglages, puis revenez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग्ज़ में Kūki के लिए होम ऐक्सेस की अनुमति दें, फिर वापस आएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan akses Rumah untuk Kūki di Pengaturan, lalu kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a Kūki l'accesso a Casa in Impostazioni, poi torna qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」でKūkiに「ホーム」へのアクセスを許可してから、戻ってきてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 Kūki의 홈 접근을 허용한 다음 다시 돌아오세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef Kūki toegang tot Woning in Instellingen en kom dan terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól Kūki na dostęp do aplikacji Dom w Ustawieniach, a potem wróć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso à Casa para o Kūki em Ajustes e depois volte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Kūki доступ к «Дому» в Настройках, затем вернитесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt Hem-åtkomst för Kūki i Inställningar och kom sedan tillbaka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตให้ Kūki เข้าถึงบ้านในการตั้งค่า แล้วกลับมาที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar'da Kūki'ye Ev erişimi verin, sonra geri dönün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозвольте Kūki доступ до «Дому» в Параметрах, а потім поверніться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép Kūki truy cập Nhà trong Cài đặt, rồi quay lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”中允许 Kūki 访问“家庭”，然后返回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」中允許 Kūki 取用「家庭」，然後返回。"
          }
        }
      }
    },
    "Allow Kūki in System Settings › Privacy & Security › Home, then come back." : {
      "comment" : "Shown when Kūki has no access to Apple Home (Mac). Use the System Settings names macOS shows in your language.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لـ Kūki في إعدادات النظام › الخصوصية والأمن › المنزل، ثم عُد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben Sie Kūki unter Systemeinstellungen › Datenschutz & Sicherheit › Home und kommen Sie dann zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
