    "Stays under 1000 ppm all night." : {
      "comment" : "Onboarding, Night screen: readout for a closed bedroom that never reaches 1000 ppm",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى دون 1000 ppm طوال الليل."
          }
        },
        "de" : {
          "stringUnit" : {
