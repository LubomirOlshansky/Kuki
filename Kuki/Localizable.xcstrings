        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quella sensazione di aria viziata spesso inizia qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あのこもった感じは、たいていこのあたりから始まります。"
