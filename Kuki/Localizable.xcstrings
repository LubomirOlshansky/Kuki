          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o Kūki em Ajustes do Sistema › Privacidade e Segurança › Casa e depois volte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ для Kūki: Системные настройки › Конфиденциальность и безопасность › Дом. Затем вернитесь."
