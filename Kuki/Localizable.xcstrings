          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki показує те, що вимірює ваш датчик. Це не медичний виріб."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki hiển thị những gì cảm biến của bạn đo được. Kūki không phải là thiết bị y tế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
