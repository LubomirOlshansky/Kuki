    "That's the air around your sensor right now." : {
      "comment" : "Onboarding, Apple Home screen: under the first live reading",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا هو الهواء حول مستشعرك الآن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So ist die Luft gerade um Ihren Sensor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este es el aire que rodea tu sensor ahora mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voici l'air autour de votre capteur en ce moment."
