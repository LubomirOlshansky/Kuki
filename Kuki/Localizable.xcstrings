    "Guess first: two people asleep, window shut, eight hours. Where does CO₂ end up?" : {
      "comment" : "Onboarding, Night screen: quiz question; the answers are CO₂ values in ppm",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خمّن أولًا: شخصان نائمان، والنافذة مغلقة، وثماني ساعات. إلى أين يصل CO₂؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst raten: zwei Schlafende, Fenster zu, acht Stunden. Wo landet das CO₂?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adivina primero: dos personas durmiendo, ventana cerrada, ocho horas. ¿Dónde acaba el CO₂?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devinez d'abord : deux personnes endormies, fenêtre fermée, huit heures. Où le CO₂ finit-il ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले अनुमान लगाएँ: दो लोग सो रहे हैं, खिड़की बंद, आठ घंटे। CO₂ कहाँ तक पहुँचेगा?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tebak dulu: dua orang tidur, jendela tertutup, delapan jam. Sampai di mana CO₂ akhirnya?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima indovina: due persone che dormono, finestra chiusa, otto ore. Dove arriva la CO₂?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず予想してみてください。2人が眠り、窓は閉めたまま、8時間。CO₂はどこまで上がるでしょう？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 예상해 보세요. 두 사람이 자고, 창문은 닫힌 채, 8시간. CO₂는 어디까지 오를까요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raad eerst: twee mensen slapen, raam dicht, acht uur. Waar komt de CO₂ uit?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw zgadnij: dwie osoby śpią, okno zamknięte, osiem godzin. Ile będzie CO₂?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro, um palpite: duas pessoas dormindo, janela fechada, oito horas. Onde o CO₂ vai parar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала угадайте: двое спят, окно закрыто, восемь часов. Сколько будет CO₂?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gissa först: två personer sover, fönstret stängt, åtta timmar. Var hamnar CO₂?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองทายก่อน: สองคนนอนหลับ ปิดหน้าต่าง แปดชั่วโมง CO₂ จะขึ้นไปถึงเท่าไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce tahmin edin: iki kişi uyuyor, pencere kapalı, sekiz saat. CO₂ nereye ulaşır?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спершу вгадайте: двоє сплять, вікно зачинене, вісім годин. Скільки буде CO₂?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đoán trước nhé: hai người ngủ, cửa sổ đóng, tám tiếng. CO₂ sẽ lên đến đâu?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先猜一猜：两人睡觉，窗户紧闭，八小时。CO₂ 最终会到多少？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先猜猜看：兩人睡覺，窗戶緊閉，八小時。CO₂ 最後會到多少？"
          }
        }
      }
    },
