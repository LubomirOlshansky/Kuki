        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảm biến demo bắt đầu ở %@. Kết nối cảm biến thật bất cứ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "演示传感器从%@开始。可随时在“设置”中连接真实的传感器。"
