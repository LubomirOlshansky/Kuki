        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảm giác ngột ngạt ấy thường bắt đầu từ đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
