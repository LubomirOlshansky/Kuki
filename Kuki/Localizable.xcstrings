    "Tell Kūki which room the sensor is in." : {
      "comment" : "Onboarding, Listen screen: feature, first sentence (in ink)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخبر Kūki بالغرفة التي فيها المستشعر."
          }
        },
        "de" : {
