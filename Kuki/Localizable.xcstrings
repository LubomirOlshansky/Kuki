    "Recording is paused until it's back." : {
      "comment" : "Mac menu bar menu, detail line: recording resumes when the sensor is reachable again. 'it' = the sensor.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التسجيل متوقف مؤقتًا حتى يعود المستشعر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufzeichnung pausiert, bis er wieder erreichbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro está en pausa hasta que vuelva."
          }
        },
        "fr" : {
