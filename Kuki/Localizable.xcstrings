    "For focus: open a window before long work, not after." : {
      "comment" : "Onboarding, Breath screen: personal line for users who chose the Focus goal",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للتركيز: افتح نافذة قبل العمل الطويل، لا بعده."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Konzentration: Öffnen Sie ein Fenster vor langer Arbeit, nicht danach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para concentrarte: abre una ventana antes de un trabajo largo, no después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour la concentration : ouvrez une fenêtre avant un long travail, pas après."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एकाग्रता के लिए: लंबे काम से पहले खिड़की खोलें, बाद में नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk fokus: buka jendela sebelum bekerja lama, bukan sesudahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per la concentrazione: apri una finestra prima di un lungo lavoro, non dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集中のために：長い作業の後ではなく、前に窓を開けましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집중을 위해: 긴 작업을 마친 뒤가 아니라 시작하기 전에 창문을 여세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor focus: zet een raam open vóór lang werk, niet erna."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla skupienia: otwórz okno przed dłuższą pracą, nie po niej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para o foco: abra uma janela antes de um trabalho longo, não depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для концентрации: открывайте окно до долгой работы, а не после."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För fokus: öppna ett fönster före långt arbete, inte efter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อสมาธิ: เปิดหน้าต่างก่อนเริ่มงานยาวๆ ไม่ใช่หลังจากนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odak için: uzun bir çalışmadan önce pencere açın, sonra değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для зосередженості: відчиняйте вікно перед тривалою роботою, а не після."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để tập trung: mở cửa sổ trước khi làm việc lâu, không phải sau đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了专注：在长时间工作之前开窗，而不是之后。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了專注：在長時間工作之前開窗，而不是之後。"
          }
        }
      }
    },
