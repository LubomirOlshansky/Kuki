          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzięki temu Kūki wróci na pasek menu po ponownym uruchomieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assim o Kūki volta à barra de menus depois de reiniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы Kūki снова был в строке меню после перезагрузки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så att Kūki finns i menyraden igen efter en omstart."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อให้ Kūki กลับมาอยู่ในแถบเมนูหลังรีสตาร์ท"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Böylece Kūki yeniden başlatmadan sonra menü çubuğuna geri gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб Kūki знову з’являвся в смузі меню після перезавантаження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để Kūki trở lại thanh menu sau khi khởi động lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这样重新启动后，Kūki 会回到菜单栏。"
