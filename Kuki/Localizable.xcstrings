    "That stuffy feeling often starts here." : {
      "comment" : "Onboarding, Breath screen: personal line for users who chose the Feeling fresh goal; stuffy = stale indoor air",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غالبًا ما يبدأ ذلك الإحساس بالركود من هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das stickige Gefühl beginnt oft hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa sensación de ambiente cargado suele empezar aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sensation d'air confiné commence souvent ici."
