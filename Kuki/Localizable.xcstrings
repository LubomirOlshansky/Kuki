        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ önce soracak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш %@ спершу запитає."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ của bạn sẽ hỏi trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会先征求许可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 會先徵求許可。"
          }
        }
      }
    },
    "Your ALPSTUGA talks to a home hub over Thread. Apple Home passes its readings to Kūki." : {
      "comment" : "Onboarding, pipeline diagram: VoiceOver description. Thread is the name of a wireless protocol, keep it.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتواصل ALPSTUGA مع مركز المنزل عبر Thread. وينقل Apple Home قراءاته إلى Kūki."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr ALPSTUGA spricht über Thread mit einer Steuerzentrale. Apple Home gibt seine Messwerte an Kūki weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ALPSTUGA se comunica con una central de casa mediante Thread. Apple Home pasa sus lecturas a Kūki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre ALPSTUGA communique avec un concentrateur domestique via Thread. Apple Home transmet ses mesures à Kūki."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका ALPSTUGA, Thread के ज़रिए एक होम हब से बात करता है। Apple Home इसकी रीडिंग Kūki तक पहुँचाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALPSTUGA Anda terhubung ke hub rumah melalui Thread. Apple Home meneruskan pembacaannya ke Kūki."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo ALPSTUGA comunica con un hub della casa tramite Thread. Apple Home passa le sue rilevazioni a Kūki."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALPSTUGAはThreadでホームハブと通信します。Apple Homeがその測定値をKūkiに渡します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALPSTUGA는 Thread를 통해 홈 허브와 통신합니다. Apple Home이 측정값을 Kūki에 전달합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ALPSTUGA praat via Thread met een woningcentrum. Apple Home geeft zijn metingen door aan Kūki."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój ALPSTUGA łączy się z centrum domowym przez Thread. Apple Home przekazuje jego odczyty do Kūki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu ALPSTUGA fala com uma central da casa via Thread. O Apple Home repassa as leituras dele ao Kūki."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш ALPSTUGA связывается с домашним центром по Thread. Apple Home передаёт его показания в Kūki."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din ALPSTUGA pratar med en hemhubb via Thread. Apple Home skickar vidare dess mätvärden till Kūki."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALPSTUGA ของคุณสื่อสารกับศูนย์กลางบ้านผ่าน Thread แล้ว Apple Home จะส่งค่าที่วัดได้ต่อให้ Kūki"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALPSTUGA'nız Thread üzerinden bir ev merkeziyle konuşur. Apple Home değerlerini Kūki'ye iletir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш ALPSTUGA зв’язується з домашнім центром через Thread. Apple Home передає його покази в Kūki."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALPSTUGA của bạn giao tiếp với trung tâm nhà qua Thread. Apple Home chuyển số đo của nó tới Kūki."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALPSTUGA 通过 Thread 与家居中枢通信。Apple Home 将其读数传给 Kūki。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALPSTUGA 透過 Thread 與家庭中樞通訊。Apple Home 將其讀數傳給 Kūki。"
          }
        }
      }
    },
    "Your answers shape the tips and your plan. Change them any time in Settings." : {
      "comment" : "Onboarding, Questions screen: footnote",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشكّل إجاباتك النصائح وخطتك. غيّرها في أي وقت من الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Antworten prägen die Tipps und Ihren Plan. Sie können sie jederzeit in den Einstellungen ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus respuestas dan forma a los consejos y a tu plan. Cámbialas cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos réponses orientent les conseils et votre plan. Modifiez-les à tout moment dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके जवाब सुझावों और आपकी योजना को आकार देते हैं। उन्हें कभी भी सेटिंग्ज़ में बदलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawaban Anda membentuk tips dan rencana Anda. Ubah kapan saja di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue risposte orientano i consigli e il tuo piano. Puoi cambiarle quando vuoi in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答に合わせて、ヒントとプランを作ります。回答は「設定」でいつでも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답변에 따라 팁과 계획이 정해집니다. 설정에서 언제든 바꿀 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je antwoorden bepalen de tips en je plan. Wijzig ze wanneer je wilt in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje odpowiedzi kształtują wskazówki i Twój plan. Zmienisz je w każdej chwili w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas respostas moldam as dicas e o seu plano. Altere-as quando quiser em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши ответы определяют советы и план. Изменить их можно в любой момент в Настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina svar formar tipsen och din plan. Ändra dem när som helst i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำตอบของคุณช่วยกำหนดเคล็ดลับและแผนของคุณ เปลี่ยนได้ทุกเมื่อในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanıtlarınız ipuçlarını ve planınızı şekillendirir. İstediğiniz zaman Ayarlar'dan değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
