    "36 young adults in simulated bedrooms at 750, 1000 and 1300 ppm: sleep efficiency fell by 1.3 and 1.8 points." : {
      "comment" : "Onboarding, Sources list: what a cited study or guideline says, shown under its citation. Numbers, units and proper names stay.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "36 شابًا بالغًا في غرف نوم محاكاة عند 750 و1000 و1300 ppm: انخفضت كفاءة النوم بمقدار 1.3 و1.8 نقطة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "36 junge Erwachsene in simulierten Schlafzimmern bei 750, 1000 und 1300 ppm: Die Schlafeffizienz sank um 1,3 und 1,8 Punkte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "36 adultos jóvenes en dormitorios simulados a 750, 1000 y 1300 ppm: la eficiencia del sueño bajó 1,3 y 1,8 puntos."
          }
        },
        "fr" : {
