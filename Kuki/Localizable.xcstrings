        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse é o ar ao redor do seu sensor agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это воздух вокруг Вашего датчика прямо сейчас."
