    "Exported: %@ (time zone %@)" : {
      "comment" : "Markdown export brief for an AI assistant: bullet. Placeholders: the export date and time, then a time-zone identifier such as Europe/Berlin.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم التصدير: %1$@ (المنطقة الزمنية %2$@)"
