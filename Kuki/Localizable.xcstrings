    "CO₂" : {
      "comment" : "VoiceOver: the metric name carbon dioxide before a value. Keep CO₂ unless your language reads it differently.",
      "shouldTranslate" : false
    },
    "CO₂ from a sleeping adult, used in Kūki's estimate: 0.0035 L/s, in a 30 m³ room with 0.5 air changes an hour." : {
      "comment" : "Onboarding, Sources list: what a cited study or guideline says, shown under its citation. Numbers, units and proper names stay.",
