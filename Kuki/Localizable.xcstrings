    "No place reached the %@ ppm limit. %@ averaged highest, %@." : {
      "comment" : "History chart, VoiceOver summary. Placeholders: the CO₂ limit in ppm, a room's name, a spoken value such as 'CO₂ 812 parts per million'.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يبلغ أي مكان حد %1$@ ppm. الأعلى في المتوسط: %2$@، %3$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Ort erreichte den Grenzwert von %1$@ ppm. %2$@ hatte den höchsten Durchschnitt, %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No place reached the %1$@ ppm limit. %2$@ averaged highest, %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún lugar alcanzó el límite de %1$@ ppm. %2$@ tuvo la media más alta, %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun lieu n'a atteint le seuil de %1$@ ppm. %2$@ a eu la moyenne la plus élevée, %3$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई भी जगह %1$@ ppm की सीमा तक नहीं पहुँची। %2$@ का औसत सबसे ज़्यादा रहा, %3$@।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada tempat yang mencapai batas %1$@ ppm. Rata-rata tertinggi ada di %2$@, %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun luogo ha raggiunto la soglia di %1$@ ppm. %2$@ ha avuto la media più alta, %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ppmの上限に達した場所はありません。平均が最も高かったのは%2$@で、%3$@でした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ppm 기준치에 도달한 장소는 없습니다. 평균이 가장 높은 곳은 %2$@, %3$@입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen enkele plek bereikte de grens van %1$@ ppm. %2$@ had het hoogste gemiddelde, %3$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żadne miejsce nie osiągnęło progu %1$@ ppm. Najwyższa średnia: %2$@, %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum local chegou ao limite de %1$@ ppm. %2$@ teve a média mais alta, %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни одно место не достигло порога %1$@ ppm. Выше всего в среднем — %2$@, %3$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen plats nådde gränsen på %1$@ ppm. %2$@ hade högst snitt, %3$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีตำแหน่งใดถึงเกณฑ์ %1$@ ppm %2$@ มีค่าเฉลี่ยสูงสุด %3$@"
          }
        },
        "tr" : {
