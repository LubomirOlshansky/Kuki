    "Carry it around and each room keeps its own history." : {
      "comment" : "Onboarding, Listen screen: feature, second sentence (in grey)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقله معك، وستحتفظ كل غرفة بسجلها الخاص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tragen Sie ihn herum, und jeder Raum bekommt seinen eigenen Verlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llévalo contigo y cada habitación tendrá su propio historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emportez-le avec vous : chaque pièce garde son propre historique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे साथ ले जाएँ, और हर कमरे का अपना इतिहास बनता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bawa ke mana-mana, dan setiap ruangan menyimpan riwayatnya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portalo con te e ogni stanza avrà la sua cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持ち歩けば、部屋ごとに記録が残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "들고 다니면 방마다 기록이 따로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem hem mee en elke kamer krijgt zijn eigen geschiedenis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenoś go, a każdy pokój będzie miał własną historię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leve-o pela casa e cada cômodo mantém seu próprio histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переносите его — у каждой комнаты будет своя история."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bär runt den, så får varje rum sin egen historik."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พกไปด้วย แล้วแต่ละห้องจะเก็บประวัติของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onu yanınızda taşıyın, her odanın kendi geçmişi olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переносьте його — кожна кімната матиме власну історію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mang theo đi khắp nơi, và mỗi phòng sẽ có lịch sử riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随身带着它，每个房间都会保留各自的记录。"
