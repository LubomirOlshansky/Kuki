    "Somewhere else…" : {
      "comment" : "Onboarding, Place screen: choice that opens a field to name a new room",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مكان آخر…"
          }
        },
        "de" : {
