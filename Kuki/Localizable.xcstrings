    "Plug in your ALPSTUGA. It's ready to pair once it powers up." : {
      "comment" : "Onboarding, Apple Home screen: setup step 1",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صِل ALPSTUGA بالكهرباء. سيكون جاهزًا للاقتران فور تشغيله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stecken Sie Ihren ALPSTUGA ein. Sobald er eingeschaltet ist, kann er gekoppelt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enchufa tu ALPSTUGA. Estará listo para enlazar en cuanto se encienda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Branchez votre ALPSTUGA. Il est prêt à être jumelé dès qu'il s'allume."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना ALPSTUGA प्लग इन करें। चालू होते ही यह पेयर होने के लिए तैयार हो जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colokkan ALPSTUGA Anda. Sensor siap dipasangkan begitu menyala."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega il tuo ALPSTUGA alla corrente. È pronto per l'abbinamento appena si accende."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ALPSTUGAを電源につないでください。起動すると、ペアリングの準備が整います。"
          }
        },
        "ko" : {
          "stringUnit" : {
