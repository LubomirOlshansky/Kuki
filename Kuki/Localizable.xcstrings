            "value" : "Bleibt die ganze Nacht unter 1000 ppm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se mantiene por debajo de 1000 ppm toda la noche."
          }
        },
        "fr" : {
