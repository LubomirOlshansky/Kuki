    "Start in %@ (%@). Move the sensor any time from the Now screen." : {
      "comment" : "Onboarding, Plan screen: the first placeholder is a room name (may include an article, e.g. 'the Bedroom'), the second its decorative kanji, e.g. 寝室 (do not translate). Now = the app's main tab.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ في %1$@ (%2$@). انقل المستشعر في أي وقت من شاشة «الآن»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr erster Ort: %1$@ (%2$@). Den Sensor können Sie jederzeit im Bildschirm „Jetzt“ umsetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start in %1$@ (%2$@). Move the sensor any time from the Now screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza aquí: %1$@ (%2$@). Mueve el sensor cuando quieras desde la pantalla Ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez ici : %1$@ (%2$@). Déplacez le capteur quand vous voulez depuis l'écran Maintenant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) में शुरू करें। सेंसर को कभी भी “अभी” स्क्रीन से दूसरी जगह ले जाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai di %1$@ (%2$@). Pindahkan sensor kapan saja dari layar Sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia da qui: %1$@ (%2$@). Sposta il sensore quando vuoi dalla schermata Adesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）から始めましょう。センサーはいつでも「現在」画面から移動できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@(%2$@)에서 시작합니다. 센서는 언제든 현재 화면에서 옮길 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin in %1$@ (%2$@). Verplaats de sensor wanneer je wilt vanuit het scherm Nu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na start: %1$@ (%2$@). Czujnik przeniesiesz w każdej chwili na ekranie Teraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local inicial: %1$@ (%2$@). Mude o sensor de lugar quando quiser na tela Agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первое место — %1$@ (%2$@). Датчик можно перенести в любой момент на экране «Сейчас»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startplats: %1$@ (%2$@). Flytta sensorn när som helst från skärmen Nu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มที่%1$@ (%2$@) ย้ายเซ็นเซอร์ได้ทุกเมื่อจากหน้าจอตอนนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk yer: %1$@ (%2$@). Sensörü istediğiniz zaman Şimdi ekranından taşıyabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перше місце — %1$@ (%2$@). Датчик можна перенести будь-коли на екрані «Зараз»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu ở %1$@ (%2$@). Di chuyển cảm biến bất cứ lúc nào từ màn hình Hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从%1$@（%2$@）开始。可随时在“当前”屏幕中移动传感器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從%1$@（%2$@）開始。可隨時在「目前」畫面中移動感測器。"
          }
        }
      }
    },
