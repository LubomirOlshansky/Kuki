          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki следит за одним датчиком. Сменить его можно в Настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
