    "For bedrooms and sleep. Close to Europe's strictest bedroom level." : {
      "comment" : "Onboarding, Fūrin screen: subtitle of the 800 ppm limit",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لغرف النوم والنوم. قريب من أشد مستوى أوروبي لغرف النوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Schlafzimmer und Schlaf. Nahe am strengsten Schlafzimmerwert Europas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para dormitorios y para dormir. Cerca del nivel más estricto de Europa para dormitorios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les chambres et le sommeil. Proche du niveau le plus strict d'Europe pour les chambres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेडरूम और नींद के लिए। यूरोप के सबसे सख़्त बेडरूम स्तर के क़रीब।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk kamar tidur dan tidur. Mendekati level kamar tidur paling ketat di Eropa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per camere da letto e sonno. Vicina al livello più severo d'Europa per le camere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寝室と睡眠のために。ヨーロッパで最も厳しい寝室の基準に近い値です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "침실과 수면용. 유럽에서 가장 엄격한 침실 기준에 가깝습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor slaapkamers en slaap. Dicht bij de strengste Europese norm voor slaapkamers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla sypialni i snu. Blisko najsurowszego europejskiego poziomu dla sypialni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para quartos e sono. Próximo do nível mais rigoroso da Europa para quartos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для спален и сна. Близко к самому строгому европейскому уровню для спален."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För sovrum och sömn. Nära Europas strängaste nivå för sovrum."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำหรับห้องนอนและการนอน ใกล้เคียงระดับห้องนอนที่เข้มงวดที่สุดในยุโรป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yatak odaları ve uyku için. Avrupa'nın en katı yatak odası seviyesine yakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для спалень і сну. Близько до найсуворішого європейського рівня для спалень."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phòng ngủ và giấc ngủ. Gần với mức nghiêm ngặt nhất cho phòng ngủ ở châu Âu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适合卧室与睡眠。接近欧洲最严格的卧室标准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適合臥室與睡眠。接近歐洲最嚴格的臥室標準。"
          }
        }
      }
    },
