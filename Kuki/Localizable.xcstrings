    "Open it wide now. A tilted window can't keep up." : {
      "comment" : "Advice when indoor air is stuffy, for someone whose window is usually tilted open (a tilt-and-turn window). 'it' = the window.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتحها على مصراعيها الآن. النافذة المائلة لا تكفي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt weit öffnen. Gekippt kommt das Fenster nicht hinterher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ábrela del todo ahora. Entreabierta no da abasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez-la grand maintenant. Entrouverte, elle ne suffit pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी इसे पूरी खोलें। झुकी हुई खिड़की से उतनी हवा नहीं बदलती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka lebar sekarang. Jendela yang dimiringkan tidak cukup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spalancala ora. A vasistas non basta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いますぐ大きく開けましょう。少し傾けただけの窓では追いつきません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 활짝 여세요. 살짝 기울여 연 창문으로는 부족합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet het nu wijd open. Een kiepraam kan het niet bijhouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz je teraz szeroko. Uchylone okno nie nadąży."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra-a bem agora. Uma janela entreaberta não dá conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте окно настежь. Откинутая створка не справляется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna det helt nu. Ett fönster i vädringsläge hinner inte med."
          }
