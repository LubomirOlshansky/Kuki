    "%@ A gentle line for sleep." : {
      "comment" : "Onboarding, Plan screen: appended when the user chose the low 800 ppm limit for sleep; the placeholder is the previous sentence. Line = the CO₂ limit.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ حدّ لطيف للنوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ein sanfter Grenzwert für den Schlaf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Un límite suave para dormir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Un seuil doux pour le sommeil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ नींद के लिए एक कोमल सीमा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Batas yang lembut untuk tidur."
          }
        },
        "it" : {
