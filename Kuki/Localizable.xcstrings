            "value" : "%@ Una soglia delicata per il sonno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@眠りのための、やさしい基準です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 수면을 위한 부드러운 기준선입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Een zachte grens voor de nachtrust."
          }
        },
        "pl" : {
