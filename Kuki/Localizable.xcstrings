    "Why air matters, how Kūki works, and your plan — a few minutes." : {
      "comment" : "Settings › Introduction: section footer",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لماذا يهم الهواء، وكيف يعمل Kūki، وخطتك — بضع دقائق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warum Luft wichtig ist, wie Kūki funktioniert und Ihr Plan – in wenigen Minuten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por qué importa el aire, cómo funciona Kūki y tu plan — en unos minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi l'air compte, comment fonctionne Kūki, et votre plan — en quelques minutes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हवा क्यों मायने रखती है, Kūki कैसे काम करता है, और आपकी योजना — कुछ मिनट।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengapa udara penting, cara kerja Kūki, dan rencana Anda — beberapa menit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perché l'aria conta, come funziona Kūki e il tuo piano — in pochi minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空気が大切な理由、Kūkiのしくみ、そしてプラン — 数分で見られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공기가 중요한 이유, Kūki의 작동 방식, 그리고 나의 계획 — 몇 분이면 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarom lucht ertoe doet, hoe Kūki werkt en je plan — een paar minuten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dlaczego powietrze ma znaczenie, jak działa Kūki i Twój plan — kilka minut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por que o ar importa, como o Kūki funciona e o seu plano — alguns minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почему важен воздух, как работает Kūki и Ваш план — несколько минут."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varför luften spelar roll, hur Kūki fungerar och din plan — några minuter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำไมอากาศจึงสำคัญ Kūki ทำงานอย่างไร และแผนของคุณ — ใช้เวลาไม่กี่นาที"
