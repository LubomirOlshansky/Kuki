    "About 3–5 minutes wide open in cold weather, 10–20 on warm days." : {
      "comment" : "Onboarding, Sources list: what a cited study or guideline says, shown under its citation. Numbers, units and proper names stay.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نحو 3–5 دقائق والنافذة مفتوحة على مصراعيها في الطقس البارد، و10–20 في الأيام الدافئة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa 3–5 Minuten weit offen bei Kälte, 10–20 an warmen Tagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos 3–5 minutos abierta de par en par cuando hace frío, 10–20 en días templados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ 3–5 minutes grande ouverte par temps froid, 10–20 par temps chaud."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ठंड में लगभग 3–5 मिनट पूरी खुली, गर्म दिनों में 10–20।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekitar 3–5 menit terbuka lebar saat cuaca dingin, 10–20 pada hari yang hangat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circa 3–5 minuti spalancata quando fa freddo, 10–20 nelle giornate calde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寒い時期は約3〜5分、暖かい日は10〜20分、窓を大きく開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추운 날에는 약 3–5분, 따뜻한 날에는 10–20분 활짝 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
