        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamar tidur yang tertutup cepat terisi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una camera chiusa si riempie in fretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閉め切った寝室には、吐く息がすぐにたまります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "닫힌 침실에는 내쉰 숨이 금세 쌓입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In een dichte slaapkamer wordt het snel benauwd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W zamkniętej sypialni szybko robi się duszno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um quarto fechado fica abafado rápido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В закрытой спальне CO₂ быстро копится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett stängt sovrum blir snabbt kvavt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ห้องนอนที่ปิดสนิทจะเต็มเร็ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalı bir yatak odasında CO₂ hızla birikir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У зачиненій спальні CO₂ швидко накопичується."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phòng ngủ đóng kín đầy lên rất nhanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "门窗紧闭的卧室，很快就积满呼出的气。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "門窗緊閉的臥室，很快就積滿呼出的氣。"
          }
        }
      }
    },
    "A daily reminder to open a window wide for 5 minutes. It comes at the times you set: it can't read the air, so it may arrive when the room is already fresh." : {
      "comment" : "Settings › Airing reminder: section footer explaining the daily reminder",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذكير يومي بفتح نافذة على مصراعيها لمدة 5 دقائق. يصل في الأوقات التي تحددها: لا يمكنه قراءة الهواء، لذا قد يصل والغرفة منتعشة بالفعل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine tägliche Erinnerung, ein Fenster 5 Minuten lang weit zu öffnen. Sie kommt zu den Zeiten, die Sie festlegen: Sie kann die Luft nicht messen und kommt daher womöglich, wenn der Raum schon frisch ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un recordatorio diario para abrir bien una ventana durante 5 minutos. Llega a las horas que elijas: no puede medir el aire, así que puede llegar cuando la habitación ya está fresca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rappel quotidien pour ouvrir grand une fenêtre pendant 5 minutes. Il arrive aux heures que vous choisissez : il ne mesure pas l'air, il peut donc arriver quand la pièce est déjà fraîche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर दिन एक रिमाइंडर कि 5 मिनट के लिए खिड़की पूरी खोलें। यह आपके तय किए समय पर आता है: यह हवा नहीं पढ़ सकता, इसलिए तब भी आ सकता है जब कमरा पहले से ताज़ा हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengingat harian untuk membuka jendela lebar-lebar selama 5 menit. Pengingat datang pada waktu yang Anda atur: ia tidak bisa membaca udara, jadi mungkin datang saat ruangan sudah segar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un promemoria giornaliero per spalancare una finestra per 5 minuti. Arriva agli orari che scegli: non può leggere l'aria, quindi può arrivare quando la stanza è già fresca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窓を大きく開けて5分間換気するよう、毎日お知らせします。設定した時刻に届くもので、空気を読み取るわけではないため、部屋の空気がすでに新鮮なときに届くこともあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창문을 활짝 열고 5분간 환기하라는 매일 알림입니다. 설정한 시간에 오며 공기를 측정하지 않으므로, 방 공기가 이미 신선할 때 올 수도 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een dagelijkse herinnering om 5 minuten een raam wijd open te zetten. Hij komt op de tijden die je instelt: hij kan de lucht niet lezen, dus misschien is de kamer dan al fris."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codzienne przypomnienie, by na 5 minut szeroko otworzyć okno. Przychodzi o ustawionych porach: nie odczytuje powietrza, więc może się pojawić, gdy w pokoju jest już świeżo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um lembrete diário para abrir bem uma janela por 5 minutos. Ele chega nos horários definidos: não lê o ar, então pode chegar quando o cômodo já estiver fresco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ежедневное напоминание широко открыть окно на 5 минут. Оно приходит в заданное время: Kūki не знает, какой сейчас воздух, поэтому напоминание может прийти, когда в комнате уже свежо."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En daglig påminnelse om att öppna ett fönster helt i 5 minuter. Den kommer på tiderna du ställer in: den kan inte läsa av luften, så den kan komma när luften i rummet redan är frisk."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเตือนรายวันให้เปิดหน้าต่างให้กว้างเป็นเวลา 5 นาที การเตือนจะมาตามเวลาที่คุณตั้งไว้ โดยไม่ได้อ่านค่าอากาศ จึงอาจมาตอนที่ห้องสดชื่นอยู่แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir pencereyi 5 dakika ardına kadar açmanız için günlük bir hatırlatıcı. Belirlediğiniz saatlerde gelir: havayı ölçemez, bu yüzden oda zaten temizken de gelebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоденне нагадування відчинити вікно навстіж на 5 хвилин. Воно надходить у задані години: Kūki не знає, яке зараз повітря, тож нагадування може прийти, коли в кімнаті вже свіжо."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lời nhắc hằng ngày để mở rộng cửa sổ trong 5 phút. Lời nhắc đến vào giờ bạn đặt: nó không đọc được không khí, nên có thể đến khi phòng đã thoáng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天提醒将窗户大开 5 分钟。提醒按设定的时间送达：它无法读取空气，因此可能在房间已经清新时出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天提醒將窗戶大開 5 分鐘。提醒會在設定的時間送達：它無法讀取空氣，因此可能在房間已經清新時出現。"
          }
        }
      }
    },
    "A few minutes on why air matters, then we'll find your sensor." : {
      "comment" : "Onboarding, Welcome screen: body line",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بضع دقائق عن أهمية الهواء، ثم سنجد مستشعرك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein paar Minuten dazu, warum Luft wichtig ist – dann suchen wir Ihren Sensor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos minutos sobre por qué importa el aire y luego buscaremos tu sensor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelques minutes sur l'importance de l'air, puis nous trouverons votre capteur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ मिनट इस पर कि हवा क्यों मायने रखती है, फिर हम आपका सेंसर ढूँढेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa menit tentang mengapa udara penting, lalu kita akan menemukan sensor Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualche minuto sul perché l'aria conta, poi troveremo il tuo sensore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空気がなぜ大切なのかを数分でご紹介し、そのあとセンサーを探します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공기가 왜 중요한지 몇 분간 살펴본 뒤, 센서를 찾아보겠습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een paar minuten over waarom lucht ertoe doet, daarna zoeken we je sensor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilka minut o tym, dlaczego powietrze ma znaczenie, a potem znajdziemy Twój czujnik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns minutos sobre por que o ar importa, depois vamos encontrar o seu sensor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Несколько минут о том, почему важен воздух, а затем найдём Ваш датчик."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Några minuter om varför luften spelar roll, sedan hittar vi din sensor."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เวลาไม่กี่นาทีเพื่อเล่าว่าทำไมอากาศจึงสำคัญ จากนั้นเราจะค้นหาเซ็นเซอร์ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Havanın neden önemli olduğuna dair birkaç dakika, ardından sensörünüzü bulacağız."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кілька хвилин про те, чому повітря важливе, а потім знайдемо ваш датчик."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vài phút về lý do không khí quan trọng, rồi chúng ta sẽ tìm cảm biến của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先用几分钟了解空气为何重要，然后寻找传感器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先用幾分鐘了解空氣為何重要，然後尋找感測器。"
          }
        }
      }
    },
