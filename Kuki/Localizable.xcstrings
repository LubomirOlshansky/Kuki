    "Last reported %@. Apple Home hasn't sent a new reading yet. It often arrives within a minute." : {
      "comment" : "Onboarding, Apple Home screen: body when the sensor's last value is old; the placeholder is a time of day, e.g. 14:05",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخر قراءة في %@. لم يرسل Apple Home قراءة جديدة بعد. وغالبًا ما تصل خلال دقيقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuletzt gemeldet um %@. Apple Home hat noch keinen neuen Messwert gesendet. Er kommt oft innerhalb einer Minute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Último dato a las %@. Apple Home aún no ha enviado una lectura nueva. Suele llegar en menos de un minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dernière mesure à %@. Apple Home n'a pas encore envoyé de nouvelle mesure. Elle arrive souvent en moins d'une minute."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आख़िरी रिपोर्ट %@ पर। Apple Home ने अभी तक नई रीडिंग नहीं भेजी है। यह अक्सर एक मिनट के अंदर आ जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terakhir melapor %@. Apple Home belum mengirim pembacaan baru. Biasanya tiba dalam satu menit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultima rilevazione alle %@. Apple Home non ha ancora inviato un nuovo valore. Spesso arriva entro un minuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最終報告は%@です。Apple Homeから新しい測定値はまだ届いていません。たいてい1分以内に届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 보고: %@. Apple Home이 아직 새 측정값을 보내지 않았습니다. 대개 1분 안에 도착합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laatst gemeld om %@. Apple Home heeft nog geen nieuwe meting gestuurd. Die komt vaak binnen een minuut."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostatni odczyt: %@. Nowy odczyt z Apple Home jeszcze nie dotarł. Często pojawia się w ciągu minuty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Última leitura às %@. O Apple Home ainda não enviou uma nova leitura. Muitas vezes ela chega em até um minuto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последние данные — в %@. Apple Home ещё не прислал новое показание. Часто оно приходит в течение минуты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senast rapporterad %@. Apple Home har inte skickat något nytt mätvärde än. Det kommer ofta inom en minut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายงานล่าสุดเมื่อ %@ Apple Home ยังไม่ได้ส่งค่าใหม่มา ปกติจะมาภายในหนึ่งนาที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son değer: %@. Apple Home henüz yeni bir değer göndermedi. Çoğu zaman bir dakika içinde gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Останні дані — о %@. Apple Home ще не надіслав нового показу. Часто він надходить протягом хвилини."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo cáo lần cuối lúc %@. Apple Home chưa gửi số đo mới. Số đo thường đến trong vòng một phút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次报告于 %@。Apple Home 尚未发送新读数，通常会在一分钟内到达。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次回報於 %@。Apple Home 尚未傳送新讀數，通常會在一分鐘內送達。"
          }
        }
      }
    },
