    "Live Activities are off for Kūki. Turn them on in Settings › Kūki." : {
      "comment" : "Error when Live Activities are disabled. 'Settings › Kūki' is the path in the iOS Settings app: use your language's name of the Settings app.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأنشطة المباشرة متوقفة لـ Kūki. شغّلها من الإعدادات › Kūki."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Aktivitäten sind für Kūki deaktiviert. Aktivieren Sie sie unter Einstellungen › Kūki."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Actividades en directo están desactivadas para Kūki. Actívalas en Ajustes › Kūki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Activités en direct sont désactivées pour Kūki. Activez-les dans Réglages › Kūki."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki के लिए लाइव ऐक्टिविटी बंद हैं। उन्हें सेटिंग्ज़ › Kūki में चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivitas Langsung dimatikan untuk Kūki. Nyalakan di Pengaturan › Kūki."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Attività in tempo reale sono disattivate per Kūki. Attivale in Impostazioni › Kūki."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūkiのライブアクティビティがオフになっています。「設定」›「Kūki」でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki의 실시간 현황이 꺼져 있습니다. 설정 › Kūki에서 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live activiteiten staan uit voor Kūki. Zet ze aan in Instellingen › Kūki."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydarzenia na żywo są wyłączone dla Kūki. Włącz je w: Ustawienia › Kūki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As Atividades ao Vivo estão desativadas para o Kūki. Ative-as em Ajustes › Kūki."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Activity для Kūki выключены. Включите их в Настройках › Kūki."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liveaktiviteter är avstängda för Kūki. Slå på dem i Inställningar › Kūki."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กิจกรรมสดปิดอยู่สำหรับ Kūki เปิดได้ใน การตั้งค่า › Kūki"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki için Canlı Etkinlikler kapalı. Ayarlar › Kūki bölümünden açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Activity для Kūki вимкнено. Увімкніть їх у Параметрах › Kūki."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoạt động trực tiếp đang tắt cho Kūki. Hãy bật trong Cài đặt › Kūki."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kūki 的实时活动已关闭。请在“设置” › “Kūki”中打开。"
          }
