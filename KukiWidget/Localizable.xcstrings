    "Ventilate now — open a window wide." : {
      "comment" : "Advice line under the air level title when indoor air is stuffy.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هوِّ الغرفة الآن — افتح نافذة على مصراعيها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt lüften – Fenster weit öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventila ahora — abre bien una ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aérez maintenant — ouvrez grand une fenêtre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी ताज़ी हवा आने दें — खिड़की पूरी खोलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventilasi sekarang — buka jendela lebar-lebar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arieggia ora — spalanca una finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いま換気しましょう — 窓を大きく開けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 환기하세요 — 창문을 활짝 여세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventileer nu — zet een raam wijd open."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewietrz teraz — otwórz szeroko okno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventile agora — abra bem uma janela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проветрите сейчас — откройте окно настежь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vädra nu — öppna ett fönster helt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระบายอากาศตอนนี้ — เปิดหน้าต่างให้กว้าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi havalandırın — pencereyi ardına kadar açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провітріть зараз — відчиніть вікно навстіж."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông gió ngay — mở rộng cửa sổ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在通风——把窗户大开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在通風——把窗戶大開。"
          }
        }
      }
    }
