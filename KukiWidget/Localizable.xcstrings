          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spalancala ora. A vasistas non basta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いますぐ大きく開けましょう。少し傾けただけの窓では追いつきません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 활짝 여세요. 살짝 기울여 연 창문으로는 부족합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
