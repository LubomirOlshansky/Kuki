    "Open it wide now. A tilted window can't keep up." : {
      "comment" : "Advice when indoor air is stuffy, for someone whose window is usually tilted open (a tilt-and-turn window). 'it' = the window.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتحها على مصراعيها الآن. النافذة المائلة لا تكفي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt weit öffnen. Gekippt kommt das Fenster nicht hinterher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ábrela del todo ahora. Entreabierta no da abasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez-la grand maintenant. Entrouverte, elle ne suffit pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी इसे पूरी खोलें। झुकी हुई खिड़की से उतनी हवा नहीं बदलती।"
          }
        },
        "id" : {
