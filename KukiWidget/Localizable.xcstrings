    "CO₂ where your sensor is, with temperature, humidity and the last few hours." : {
      "comment" : "Widget gallery: the widget's description.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CO₂ حيث يوجد مستشعرك، مع درجة الحرارة والرطوبة والساعات القليلة الماضية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CO₂ dort, wo Ihr Sensor ist, mit Temperatur, Luftfeuchte und den letzten Stunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El CO₂ donde está tu sensor, con temperatura, humedad y las últimas horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le CO₂ là où se trouve votre capteur, avec la température, l'humidité et les dernières heures."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके सेंसर की जगह का CO₂, साथ में तापमान, आर्द्रता और पिछले कुछ घंटे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CO₂ di lokasi sensor Anda, dengan suhu, kelembapan, dan beberapa jam terakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La CO₂ dove si trova il tuo sensore, con temperatura, umidità e le ultime ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "センサーのある場所のCO₂を、温度、湿度、過去数時間の推移とともに表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "센서가 있는 곳의 CO₂를 온도, 습도, 최근 몇 시간과 함께 보여 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CO₂ waar je sensor staat, met temperatuur, luchtvochtigheid en de afgelopen uren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CO₂ tam, gdzie jest Twój czujnik, a także temperatura, wilgotność i ostatnie godziny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CO₂ onde está o seu sensor, com temperatura, umidade e as últimas horas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CO₂ там, где Ваш датчик, а также температура, влажность и последние несколько часов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CO₂ där din sensor finns, med temperatur, luftfuktighet och de senaste timmarna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CO₂ ณ ตำแหน่งเซ็นเซอร์ของคุณ พร้อมอุณหภูมิ ความชื้น และช่วงไม่กี่ชั่วโมงล่าสุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensörünüzün bulunduğu yerdeki CO₂; ayrıca sıcaklık, nem ve son birkaç saat."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CO₂ там, де ваш датчик, а також температура, вологість і останні кілька годин."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CO₂ tại nơi đặt cảm biến, cùng nhiệt độ, độ ẩm và vài giờ gần đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示传感器所在位置的 CO₂，以及温度、湿度和最近几小时的变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示感測器所在位置的 CO₂，以及溫度、濕度和最近幾小時的變化。"
          }
        }
      }
